{
  "version": "v4.6-portfolio-citation-control",
  "goal": "Pursue 100,000 portfolio citation/impression opportunities in six months while preserving truthful evidence, contextual usefulness, and measured backlink quality.",
  "default_launch_date": "auto-created on first run if data/autopilot-state.json is missing",
  "daily_rules": [
    {
      "days": "1-14",
      "target_pages_per_day": 3,
      "notes": "Warm-up. One page per publication."
    },
    {
      "days": "15-45",
      "target_pages_per_day": 6,
      "condition": "last_7_day_pass_rate >= 0.85 and duplicate warnings are diagnostic only, else 3"
    },
    {
      "days": "46-90",
      "target_pages_per_day": 6,
      "condition": "hold at 6 unless pass rate drops below 0.75, then 3"
    },
    {
      "days": "91-180",
      "target_pages_per_day": "6-9",
      "condition": "9 only if last_14_day_pass_rate >= 0.85, avg_quality >= 85, duplicate warnings are diagnostic only"
    },
    {
      "days": "181-365",
      "target_pages_per_day": "6-9",
      "condition": "9 if quality remains healthy; 6 if mixed; 3 if failures rise"
    }
  ],
  "hard_limits": {
    "absolute_max_pages_per_day": 12,
    "max_duplicate_similarity": 0.15,
    "min_publish_score": 60,
    "auto_publish_score": 85,
    "approval_prep_min_pages_per_day": 4,
    "approval_prep_max_pages_per_day": 9
  },
  "social_rules": {
    "linkedin_daily_limit": 1,
    "x_daily_limit": 5,
    "do_not_post_every_page_to_linkedin": true
  },
  "gemini_policy": {
    "required": false,
    "publish_if_gemini_fails": true,
    "rewrite_only_for_scores_between": [
      72,
      84
    ]
  },
  "priority_targets": [
    {
      "brand_id": "approval-prep",
      "publication": "professional-resources",
      "pages_per_day": 6,
      "minimum": 4,
      "maximum": 9,
      "start_immediately": true,
      "quality_policy": "Aim for 5-8 pages daily and preserve aggressive momentum. Daily variation, word counts, page counts, anchor length, and product mix are warning-only; only structural corruption, false evidence, wrong-domain routing, or clearly prohibited claims may block publication.",
      "preferred_range": "5-8"
    },
    {
      "brand_id": "west-peek-productions",
      "campaign_id": "wpp-community-authority",
      "publication": "founder-operator",
      "pages_per_day": 1,
      "until_rendered_coverage": 5,
      "start_immediately": true,
      "quality_policy": "Only contextually relevant Community as a Service pages."
    },
    {
      "brand_id": "dream-wedding-builder",
      "campaign_id": "dream-planning-tools",
      "publication": "memphis-local",
      "pages_per_day": 1,
      "until_rendered_coverage": 6,
      "start_immediately": true,
      "quality_policy": "Only real wedding planning problems and matching product destinations."
    },
    {
      "brand_id": "diannes-place",
      "campaign_id": "dianne-recovery-resources",
      "publication": "professional-resources",
      "pages_per_day": 1,
      "until_rendered_coverage": 4,
      "start_immediately": true,
      "quality_policy": "Recovery housing education only; preserve clinical and licensure boundaries."
    },
    {
      "brand_id": "hicks-consulting",
      "campaign_id": "hicks-workplace-wellbeing",
      "publication": "professional-resources",
      "pages_per_day": 1,
      "until_rendered_coverage": 4,
      "start_immediately": true,
      "quality_policy": "Workplace and service education without diagnosis or outcome claims."
    },
    {
      "brand_id": "horse-legal-guide",
      "campaign_id": "horse-equine-legal",
      "publication": "professional-resources",
      "pages_per_day": 1,
      "until_rendered_coverage": 4,
      "start_immediately": true,
      "quality_policy": "Equine legal education only; no legal advice."
    }
  ],
  "city_vendor_expansion": {
    "publication_family_id": "city-vendor",
    "active_only": true,
    "candidate_cities_do_not_generate": true,
    "universal_topic_owner_required": true,
    "minimum_launch_inventory": {
      "city_specific_cornerstones": 5,
      "planning_pages": 5
    },
    "no_automatic_activation_from_roi_score": true
  },
  "portfolio_citation_objective": {
    "target": 100000,
    "window_days": 180,
    "components": [
      "owned_product_repo_surfaces",
      "authority_network_pages",
      "rendered_backlinks",
      "live_verified_backlinks",
      "indexed_referring_pages",
      "independent_external_mentions",
      "search_impressions",
      "ai_citations_or_mentions"
    ],
    "targets_are_nonblocking": true,
    "never_equate_generated_with_indexed_or_cited": true,
    "growth_profiles_path": "data/brand-growth-profiles.json",
    "product_manifest_path": "data/product-repo-manifests.json",
    "dashboard_path": "reports/citation-portfolio-dashboard.json"
  },
  "portfolio_scheduler": {
    "enabled": true,
    "method": "weighted_deficit_by_publication",
    "preserve_contextual_fit": true,
    "allow_no_link_when_no_fit": true,
    "minimum_presence_is_guidance_only": true,
    "maximum_share_is_guidance_only": true,
    "do_not_force_backlink": true,
    "campaign_registry_path": "data/portfolio-backlink-campaigns.json",
    "priority_method": "campaign_deficit_then_contextual_fit_then_yield",
    "live_evidence_never_required_to_generate_but_required_to_claim_live": true,
    "owned_network_links_truth_label": "affiliated_editorial_backlink"
  }
}
